# Day-to-day dev/test target: `podman-compose up -d` (compose.yaml) starts a
# pinned pgvector/pgvector:pg16 container matching the real server's Postgres
# version exactly.
QMD_POSTGRES_URL=postgresql+psycopg://qmd:qmd@localhost:5433/qmd
QMD_POSTGRES_SCHEMA=qmd_py
QMD_LLM_BASE_URL=http://yourserver.com:8099 # replace the server name and port

# Real server DB - use only for phase-exit live-parity checks, not routine dev/test.
# QMD_PARITY_POSTGRES_URL=postgresql+psycopg://user:pass@yourserver.com/qmd
