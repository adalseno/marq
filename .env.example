# Template for pointing marq at your own Postgres/LLM instance directly
# (e.g. production, or a real-server live-parity check). For day-to-day
# local dev/test, use `.env.dev` instead (`cp .env.dev .env`).
MARQ_POSTGRES_URL=postgresql+psycopg://user:pass@yourserver.com/qmd # replace server name and user:pass with your data
MARQ_POSTGRES_SCHEMA=qmd_py
MARQ_LLM_BASE_URL=http://yourserver.com:8099 # replace the server name and port
