# Ready-to-use local dev/test environment. Copy to `.env` and go:
#   cp .env.dev .env
#   podman-compose up -d      # starts pgvector/pgvector:pg16 on localhost:5433
#   uv run alembic upgrade head
#   uv run pytest
#
# Credentials below are the container's own throwaway defaults (compose.yaml)
# - not secrets, safe to commit. QMD_LLM_BASE_URL has no local-container
# equivalent (it's an OpenAI-style HTTP endpoint for embed/rerank/chat, e.g.
# an llama.cpp server) - point it at your own instance.
QMD_POSTGRES_URL=postgresql+psycopg://qmd:qmd@localhost:5433/qmd
QMD_POSTGRES_SCHEMA=qmd_py
QMD_LLM_BASE_URL=http://yourserver.com:8099
